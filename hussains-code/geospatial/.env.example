GEE_PROJECT_ID=your-gee-project-id  # Google Earth Engine project ID
GEE_SERVICE_ACCOUNT=                # Leave blank to use OAuth/mock
GEE_CREDENTIALS_PATH=               # Path to service account JSON file
MOCK_MODE=false                     # Set true to force mock mode regardless of GEE credentials
LOG_LEVEL=INFO                      # DEBUG for verbose output

BACKEND_URL=http://localhost:8000   # Person 2's FastAPI server URL
BACKEND_SATELLITE_FLAGS_ENDPOINT=/satellite-flags # Person 2's flag ingestion endpoint
BACKEND_API_KEY=                    # Shared API key / secret for backend authorization

BUFFER_RADIUS_METERS=500
NDVI_LOSS_THRESHOLD=-0.15
NDBI_RISE_THRESHOLD=0.10
MIN_CLUSTER_PIXELS=4
CLOUD_THRESHOLD=20
BASELINE_LOOKBACK_DAYS=90
CURRENT_WINDOW_DAYS=30
