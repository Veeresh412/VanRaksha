# Database — same as backend
DATABASE_URL=sqlite:///./vanraksha_dev.db
# For production: postgresql://user:pass@host/vanraksha

# Data paths
ISRO_DATA_PATH=hotzone/data/isro_forest_cover
GFW_DATA_PATH=hotzone/data/gfw_alerts

# Grid resolution (degrees) — 0.01 ≈ 1km²
GRID_RESOLUTION_DEG=0.01

# Risk score weights — must sum to 1.0
W_HISTORICAL_FLAGS=0.30
W_GFW_ALERTS=0.25
W_ISRO_COVER_LOSS=0.20
W_ROAD_PROXIMITY=0.15
W_SETTLEMENT_PROXIMITY=0.10

# Risk tier thresholds
RISK_HIGH_THRESHOLD=0.60
RISK_MEDIUM_THRESHOLD=0.35

# Lookback window in days
LOOKBACK_DAYS=365

# Logging
LOG_LEVEL=INFO
